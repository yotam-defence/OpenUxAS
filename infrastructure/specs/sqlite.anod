# SQLite anod spec
#
# This spec uses the system SQLite (apt package libsqlite3-dev) instead of
# downloading sqlite-autoconf-3390400 from sqlite.org, which is not reachable
# from the build sandbox. The headers, static library and pkg-config file are
# copied into INSTALL_DIR so that dependent specs (sqlitecpp, uxas) keep
# working through setenv().

import glob
import os

from e3.anod.loader import spec
from e3.anod.spec import Anod
from e3.fs import cp, mkdir, rm


class Sqlite(spec('common')):
    """SQLite (system package)."""

    @property
    def build_deps(self):
        return []

    @Anod.primitive()
    def build(self):
        multiarch = '/usr/lib/x86_64-linux-gnu'
        rm(self['INSTALL_DIR'], recursive=True)
        mkdir(self.include_dir)
        mkdir(self.lib_dir)
        mkdir(os.path.join(self.lib_dir, 'pkgconfig'))
        for h in ('sqlite3.h', 'sqlite3ext.h'):
            cp(os.path.join('/usr/include', h), self.include_dir)
        for lib in glob.glob(os.path.join(multiarch, 'libsqlite3.*')):
            cp(lib, self.lib_dir, copy_attrs=False)
        with open(os.path.join(self.lib_dir, 'pkgconfig',
                               'sqlite3.pc'), 'w') as fd:
            fd.write('prefix=%s\n'
                     'libdir=%s\n'
                     'includedir=%s\n\n'
                     'Name: SQLite\n'
                     'Description: SQL database engine (system copy)\n'
                     'Version: 3.37.2\n'
                     'Libs: -L${libdir} -lsqlite3\n'
                     'Libs.private: -lm -lz\n'
                     'Cflags: -I${includedir}\n' %
                     (self['INSTALL_DIR'], self.lib_dir, self.include_dir))
        if self.env.target.platform == 'x86_64-linux':
            mkdir(self.lib_dir + '64')
            for lib in glob.glob(os.path.join(self.lib_dir, 'libsqlite3.*')):
                cp(lib, self.lib_dir + '64', copy_attrs=False)
